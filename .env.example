# Bearer key for the API (Authorization: Bearer <key>). Leave empty to disable auth.
TTS_API_KEY=
# Change to 0.0.0.0 if for hosting service
HOST=127.0.0.1
PORT=8001
# Device used when a request does not choose one: auto (GPU if available) | gpu | cpu
TTS_DEFAULT_DEVICE=auto
# GPU index to run on, as nvidia-smi numbers them (empty = the first GPU)
TTS_GPU=
# 1 = also load the other device at startup; otherwise it loads on its first request
TTS_PRELOAD_ALL=0
# CPU model precision: fp32 | int8
VIENEU_PRECISION=fp32
# Voice used when the request omits "voice" (empty = the model's default)
TTS_DEFAULT_VOICE=
# Comma-separated origins allowed for CORS (empty = none, * = any)
ALLOWED_ORIGINS=
# Max simultaneous syntheses and how long extra requests wait (seconds) before 429
TTS_MAX_CONCURRENCY=4
TTS_QUEUE_TIMEOUT=30
# Folder for cloned voices (POST /v1/voices): custom_voices.json + clips/. Empty = ./data/voices
TTS_VOICES_DIR=
